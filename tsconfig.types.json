{
  "compilerOptions": {
    "target": "esnext",
    "module": "esnext",
    "moduleResolution": "bundler",
    "lib": ["es2022", "dom", "dom.iterable"],
    "allowJs": true,
    "checkJs": true,
    "strict": true,
    "declaration": true,
    "emitDeclarationOnly": true,
    "esModuleInterop": true,
    "types": ["google.maps"],
    "skipLibCheck": true,
    "rootDir": "src",
    "outDir": "dist/types"
  },
  "include": ["src/**/*.js"],
  "exclude": ["node_modules", "test"]
}
